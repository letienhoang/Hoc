@page "/DemoRecords/Create"
@attribute [Microsoft.AspNetCore.Mvc.ValidateAntiForgeryToken]
@model Hoc.DemoRecords.Web.Pages.DemoRecords.CreateModel

<h1>@L["DemoRecords:Create"]</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label">@L["DemoRecords:Name"]</label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label">@L["DemoRecords:Description"]</label>
        <textarea asp-for="Input.Description" class="form-control"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">@L["DemoRecords:Save"]</button>
    <a class="btn btn-outline-secondary" asp-page="/DemoRecords/Index">@L["DemoRecords:Cancel"]</a>
</form>
